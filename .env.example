# =============================================================================
# Financial SIGINT - Environment Variables
# Copy this file as .env and adjust the values for your local environment.
# NEVER commit the real .env file to version control.
# =============================================================================

# --- Ollama Configuration (Local LLM) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# --- Application Configuration ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Alpaca Markets (Broker Integration) ---
# Paper Trading Keys (no real money):
#   1. Create an account at https://app.alpaca.markets
#   2. Go to Paper Trading → Overview → API Keys → Generate New Key
#   3. Copy both keys here. NEVER commit them to git.
ALPACA_API_KEY=YOUR_API_KEY_HERE
ALPACA_SECRET_KEY=YOUR_SECRET_KEY_HERE
# ⚠️ NEVER switch to false without an explicit, reviewed decision by the team
ALPACA_PAPER=true

# --- Orchestrator ---
INGRESS_API_URL=http://localhost:8000/analyze

ALPACA_API_KEY=YOUR_API_KEY_HERE
ALPACA_SECRET_KEY=YOUR_SECRET_KEY_HERE
# ⚠️ NEVER switch to false without an explicit, reviewed decision by the team
ALPACA_PAPER=True

# --- Insider Scout (SEC Form 4 / Smart Money) ---
# Free API Key: https://finnhub.io/register
# Free plan: 60 calls/min — enough for our watchlist every 15 min.
FINNHUB_API_KEY=YOUR_FINNHUB_KEY_HERE
# Tickers to watch (comma-separated, no spaces)
INSIDER_WATCHLIST=NVDA,AAPL,MSFT,AMZN,TSLA,AMD,META
# Poll interval in seconds (900 = 15 min)
INSIDER_POLL_INTERVAL_SECONDS=900
# Minimum purchase threshold to consider "high conviction" (USD)
INSIDER_MIN_VALUE_USD=250000

# --- Earnings Scout (Earnings Calendar + Surprises) ---
# Tickers to watch for earnings events
EARNINGS_WATCHLIST=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA,AMD,JPM,GS,JNJ,LLY,XOM,NFLX,CRM,PLTR
# Days of lead time to pre-alert an imminent earnings event
EARNINGS_PRE_DAYS=1
# Poll interval in seconds (21600 = 6 hours)
EARNINGS_POLL_INTERVAL_SECONDS=21600

# --- FRED Scout (Federal Reserve Economic Data — macro data) ---
# FREE API Key: https://fred.stlouisfed.org/docs/api/api_key.html
# Without a key it still works with lower limits (100 calls/day)
FRED_API_KEY=YOUR_FRED_KEY_HERE
# Poll interval (14400 = 4 hours)
FRED_POLL_INTERVAL_SECONDS=14400

# --- Short Interest Scout (Short Squeeze Detection) ---
SHORT_WATCHLIST=NVDA,AAPL,MSFT,TSLA,AMZN,META,GOOGL,AMD,PLTR,MRNA,RIVN,LCID,SOFI
# Minimum Short % of Float threshold to consider a candidate (%)
SHORT_MIN_FLOAT_PCT=15.0
# Minimum days to cover (Short Ratio)
SHORT_MIN_RATIO=5.0
# Poll interval (86400 = 24 hours — FINRA publishes twice a month)
SHORT_POLL_INTERVAL_SECONDS=86400

# --- Options Scout (Unusual Options Flow / Smart Money) ---
OPTIONS_WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,TSLA,AMZN,META,GOOGL,AMD,JPM,GS,XOM,GLD,TLT,PLTR
# Minimum Volume/Open Interest ratio to consider activity unusual
OPTIONS_MIN_VOL_OI=2.0
# Minimum absolute volume in contracts
OPTIONS_MIN_VOLUME=500
# Minimum premium deployed in USD to filter out noise from illiquid assets
OPTIONS_MIN_PREMIUM_USD=50000
# Poll interval (7200 = 2 hours — options are real-time market data)
OPTIONS_POLL_INTERVAL_SECONDS=7200

# --- Systemic Risk Manager (Portfolio-Level Guards) ---
# Guard 1: Maximum number of simultaneous open positions
RISK_MAX_POSITIONS=5
# Guard 2: Maximum portfolio share in a single sector (fraction 0-1, e.g. 0.30 = 30%)
RISK_SECTOR_CAP=0.30
# Guard 3: Drawdown kill-switch (fraction 0-1, e.g. 0.10 = 10%)
# If the portfolio drops > 10% from its peak, all execution is halted
RISK_MAX_DRAWDOWN_PCT=0.10
# Guard 4: Maximum correlation between the new asset and open positions
# 0.85 = blocks if Pearson correlation exceeds 85%
RISK_MAX_CORRELATION=0.85
# Lookback period in days to compute historical correlation
RISK_CORR_LOOKBACK_DAYS=252

# --- Closed Feedback Loop: Telegram Alerts ---
# Setup: https://core.telegram.org/bots#botfather → /newbot → copy the token
# For the chat_id: curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# Human-In-The-Loop (HITL) - Order authorization via interactive Telegram
HITL_ENABLED=true

# Active position monitor (REST polling)
# Interval in seconds to check for changes in open positions
MONITOR_POLL_INTERVAL_SECONDS=60

# Adaptive PoP: AGC system for dynamically adjusting the signal-quality threshold
# Target win rate (we need to beat this % to consider the strategy good)
ADAPTIVE_TARGET_WIN_RATE=0.40
# P-controller gain (0.10 = 0.01 adjustment per 10% of win-rate error)
ADAPTIVE_POP_KP=0.10
# Bounds of the adaptive threshold (it will never leave this range)
ADAPTIVE_POP_MIN=0.60
ADAPTIVE_POP_MAX=0.92
# Minimum number of closed trades required to activate the adjustment (avoids overfitting)
ADAPTIVE_MIN_SAMPLE=20
